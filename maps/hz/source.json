    "events": [
      {
        "y": 2000,
        "m": 1,
        "tag": "史实",
        "title": "2000 年的杭州",
        "desc": "市区人口约 300 万，城市集中在西湖东岸与京杭运河两侧，钱塘江南岸的滨江与萧山尚待开发；没有地铁，出行依靠公交与自行车。"
      },
      {
        "y": 2001,
        "m": 3,
        "tag": "史实",
        "title": "萧山、余杭撤市设区",
        "desc": "杭州市区面积大幅扩大，城市开始跨江发展。"
      },
      {
        "y": 2001,
        "m": 7,
        "tag": "史实",
        "title": "钱江新城开始建设",
        "desc": "沿钱塘江北岸建设新的城市中心，杭州由「西湖时代」走向「钱塘江时代」。"
      },
      {
        "y": 2002,
        "m": 10,
        "tag": "史实",
        "title": "雷峰塔重建落成",
        "desc": "在原塔遗址上重建，西湖南线景区随之整治开放。"
      },
      {
        "y": 2011,
        "m": 6,
        "tag": "史实",
        "title": "西湖列入世界遗产名录",
        "desc": "杭州西湖文化景观列入联合国教科文组织世界遗产名录。"
      },
      {
        "y": 2013,
        "m": 7,
        "tag": "史实",
        "title": "杭州东站枢纽启用",
        "desc": "高速铁路主要在新的杭州东站停靠，城东新城加快发展。"
      },
      {
        "y": 2014,
        "m": 6,
        "tag": "史实",
        "title": "大运河列入世界遗产名录",
        "desc": "京杭大运河杭州段是其中的重要组成部分。"
      },
      {
        "y": 2016,
        "m": 9,
        "tag": "史实",
        "title": "G20 杭州峰会",
        "desc": "二十国集团领导人峰会在杭州国际博览中心举行。"
      },
      {
        "y": 2021,
        "m": 1,
        "tag": "模拟",
        "title": "进入模拟发展阶段",
        "desc": "此后人口、道路和区域变化按模拟规则推演，不代表真实历史。"
      }
    ],
