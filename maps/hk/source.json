    "events": [
      {
        "y": 1970,
        "m": 1,
        "tag": "史实",
        "title": "1970 年的香港",
        "desc": "人口约 390 万，市区集中在港岛北岸与九龙，维多利亚港两岸靠渡轮与汽车交通；尚无地铁。"
      },
      {
        "y": 1972,
        "m": 8,
        "tag": "史实",
        "title": "红磡海底隧道通车",
        "desc": "维多利亚港首条过海道路隧道，港岛与九龙的汽车交通不再依赖汽车渡轮。"
      },
      {
        "y": 1973,
        "m": 1,
        "tag": "史实",
        "title": "新市镇计划展开",
        "desc": "荃湾、沙田等新市镇大规模发展，人口开始向新界迁移。"
      },
      {
        "y": 1975,
        "m": 11,
        "tag": "史实",
        "title": "红磡火车站启用",
        "desc": "九广铁路总站迁至红磡，尖沙咀旧站停用。"
      },
      {
        "y": 1978,
        "m": 10,
        "tag": "史实",
        "title": "沙田马场启用",
        "desc": "建于沙田海填海土地上。"
      },
      {
        "y": 1989,
        "m": 9,
        "tag": "史实",
        "title": "东区海底隧道通车",
        "desc": "鲗鱼涌与茶果岭之间的第二条过海道路隧道。"
      },
      {
        "y": 1997,
        "m": 7,
        "tag": "史实",
        "title": "香港回归；西区海底隧道通车",
        "desc": "西九龙与港岛西之间的第三条过海道路隧道。"
      },
      {
        "y": 1998,
        "m": 7,
        "tag": "史实",
        "title": "启德机场关闭",
        "desc": "新机场在大屿山赤鱲角启用，九龙城一带的建筑高度限制随后放宽。"
      },
      {
        "y": 2021,
        "m": 1,
        "tag": "模拟",
        "title": "进入模拟发展阶段",
        "desc": "此后人口、道路和区域变化按模拟规则推演，不代表真实历史。"
      }
    ],
