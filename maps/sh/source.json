  "events": [
   {
    "y": 1990,
    "m": 1,
    "tag": "史实",
    "title": "1990 年的上海",
    "desc": "城市集中在浦西，黄浦江以东还是一片农田与仓库；地铁 1 号线刚开工，越江只有打浦路与延安东路两条隧道。"
   },
   {
    "y": 1990,
    "m": 4,
    "tag": "史实",
    "title": "浦东开发开放",
    "desc": "宣布开发开放浦东，陆家嘴、金桥、外高桥三个开发区先后设立。跨江通道开始成为这座城市的关键。"
   },
   {
    "y": 1991,
    "m": 12,
    "tag": "史实",
    "title": "南浦大桥通车",
    "desc": "黄浦江上第一座大跨度斜拉桥，浦西与浦东之间不再只靠隧道。"
   },
   {
    "y": 1993,
    "m": 5,
    "tag": "史实",
    "title": "地铁 1 号线南段试通车",
    "desc": "锦江乐园至徐家汇段先期通车，1995 年延伸到上海火车站。"
   },
   {
    "y": 1993,
    "m": 10,
    "tag": "史实",
    "title": "杨浦大桥通车",
    "desc": "与南浦大桥组成内环的越江一环，杨浦与浦东之间的通行时间大幅缩短。"
   },
   {
    "y": 1995,
    "m": 4,
    "tag": "史实",
    "title": "地铁 1 号线全线通车",
    "desc": "上海第一条地铁贯通南北，火车站、人民广场与徐家汇连成一线。"
   },
   {
    "y": 1999,
    "m": 9,
    "tag": "史实",
    "title": "地铁 2 号线试运营",
    "desc": "越过黄浦江直达陆家嘴与张江，浦东开始有了地铁。"
   },
   {
    "y": 1999,
    "m": 10,
    "tag": "史实",
    "title": "浦东国际机场通航",
    "desc": "航空枢纽东移，虹桥与浦东两场并立。"
   },
   {
    "y": 2000,
    "m": 12,
    "tag": "史实",
    "title": "明珠线通车",
    "desc": "利用铁路内环线高架改建的 3 号线，串起上海南站、中山公园与江湾镇。"
   },
   {
    "y": 2003,
    "m": 6,
    "tag": "史实",
    "title": "卢浦大桥通车",
    "desc": "世界最大跨度的钢箱拱桥，世博园区一带的越江通道成形。"
   },
   {
    "y": 2010,
    "m": 5,
    "tag": "史实",
    "title": "世博会开幕",
    "desc": "5.28 km² 的世博园区跨江布局，园区内的地铁与越江通道集中建设。"
   },
   {
    "y": 2010,
    "m": 7,
    "tag": "史实",
    "title": "虹桥枢纽启用",
    "desc": "虹桥机场二号航站楼、虹桥火车站与地铁 2、10 号线在同一枢纽换乘。"
   },
   {
    "y": 2016,
    "m": 6,
    "tag": "史实",
    "title": "上海迪士尼开园",
    "desc": "城市东南方向多了一个全天候的旅游目的地。"
   }
  ],
