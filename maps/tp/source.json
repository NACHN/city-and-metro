    "events": [
      {
        "y": 1990,
        "m": 1,
        "tag": "史实",
        "title": "1990 年的台北",
        "desc": "台北盆地内约 500 万人，城市集中在淡水河以东的老城与东区，河西的三重、板桥、新庄人口快速增长；没有捷运，出行依靠公车与机车。"
      },
      {
        "y": 1990,
        "m": 3,
        "tag": "史实",
        "title": "台北市行政区调整为 12 区",
        "desc": "原 16 个区合并调整为中正、大同、中山、松山、大安、万华、信义、士林、北投、内湖、南港、文山 12 区。"
      },
      {
        "y": 1993,
        "m": 12,
        "tag": "史实",
        "title": "基隆河截弯取直完工",
        "desc": "大直、内湖一带的弯曲河道被拉直，旧河道整理为新的城市用地，1994 年起开放开发。"
      },
      {
        "y": 1994,
        "m": 10,
        "tag": "史实",
        "title": "台北市政府迁入信义计划区",
        "desc": "市政中心东移，信义计划区成为台北的新都心。"
      },
      {
        "y": 1999,
        "m": 7,
        "tag": "史实",
        "title": "板桥车站启用",
        "desc": "铁路板桥站地下化并启用新站，周边的新板特区开始开发。"
      },
      {
        "y": 2004,
        "m": 12,
        "tag": "史实",
        "title": "台北101 落成",
        "desc": "高 508 米，当时世界最高的建筑。"
      },
      {
        "y": 2007,
        "m": 3,
        "tag": "史实",
        "title": "台湾高铁通车至台北",
        "desc": "高速铁路经板桥进入台北车站，台北到高雄最快约 90 分钟。"
      },
      {
        "y": 2008,
        "m": 3,
        "tag": "史实",
        "title": "南港展览馆启用",
        "desc": "台北的展览中心向东延伸到南港。"
      },
      {
        "y": 2010,
        "m": 11,
        "tag": "史实",
        "title": "台北国际花卉博览会",
        "desc": "在圆山、新生、美术、大佳四个园区举行，展期约半年。"
      },
      {
        "y": 2010,
        "m": 12,
        "tag": "史实",
        "title": "台北县改制为新北市",
        "desc": "盆地西侧的板桥、三重、中和、新庄等地成为新北市的行政区。"
      },
      {
        "y": 2017,
        "m": 8,
        "tag": "史实",
        "title": "台北世界大学运动会",
        "desc": "第 29 届夏季世界大学运动会在台北举行。"
      },
      {
        "y": 2021,
        "m": 1,
        "tag": "模拟",
        "title": "进入模拟发展阶段",
        "desc": "此后人口、道路和区域变化按模拟规则推演，不代表真实历史。"
      }
    ],
